# GPU hibrida: forzar GL/Vulkan de la AMD para que abrir esta app no despierte la NVIDIA.
[D-BUS Service]
Name=io.github.celluloid_player.Celluloid
Exec=/usr/bin/env VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json /usr/bin/celluloid --gapplication-service
